        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 16,
        "y": 1,
        "w": 8,
        "h": 4
      },
      "interval": "5m",
      "targets": [
        {
          "expr": "sum(count_over_time({host=\"minz-media-0\", unit=\"decypharr.service\"} |= \"| ERROR\" [5m]))",
          "legendFormat": "ERROR",
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "queryType": "range"
        },
        {
          "expr": "sum(count_over_time({host=\"minz-media-0\", unit=\"decypharr.service\"} |= \"| WARN\" [5m]))",
