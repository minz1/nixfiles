#!/bin/sh /etc/rc.common
START=99
USE_PROCD=1
export START USE_PROCD

start_service() {
	procd_open_instance
	procd_set_param command awk -v f=/var/lib/adguardhome/data/querylog.json '
BEGIN {
	if (dst == "") dst = "logger -t adguard-querylog -p daemon.info"
	b64 = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
	src = "tail -n 0 -F " f
	while ((src | getline line) > 0) {
		sub(/,"OrigAnswer":"[^"]*"/, "", line)
		if (match(line, /,"Answer":"[^"]*"/)) {
			r = (index(b64, substr(line, RSTART + 15, 1)) - 1) % 4 * 4 + int((index(b64, substr(line, RSTART + 16, 1)) - 1) / 16)
			line = substr(line, 1, RSTART - 1) ",\"Rcode\":" r substr(line, RSTART + RLENGTH)
		}
		print line | dst
		fflush(dst)
	}
}'
	procd_set_param respawn 3600 5 0
	procd_close_instance
}
